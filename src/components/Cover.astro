---
const { kind = "bot", index = 1, img = "", alt = "" } = Astro.props;
---
<div class="cover">
  {img ? (
    <img src={img} alt={alt} class="photo" />
  ) : (
    <svg viewBox="0 0 400 300" fill="none" aria-hidden="true">
      {kind === "bot" ? (
        <g>
          <rect x="40" y="45" width="320" height="210" rx="4" class="win" />
          <line x1="40" y1="80" x2="360" y2="80" class="hair" />
          <circle cx="60" cy="62" r="3.5" class="dot" />
          <circle cx="76" cy="62" r="3.5" class="dot" />
          <circle cx="92" cy="62" r="3.5" class="dot" />
          <rect x="62" y="100" width="150" height="34" rx="17" class="bub" />
          <rect x="80" y="113" width="86" height="6" rx="3" class="txt" />
          <rect x="180" y="148" width="158" height="48" rx="18" class="bub-a" />
          <rect x="198" y="162" width="112" height="6" rx="3" class="txt-d" />
          <rect x="198" y="177" width="66" height="6" rx="3" class="txt-d" />
          <rect x="62" y="212" width="62" height="27" rx="13.5" class="bub" />
          <circle cx="79" cy="225" r="3.5" class="pip" style="--i:0" />
          <circle cx="93" cy="225" r="3.5" class="pip" style="--i:1" />
          <circle cx="107" cy="225" r="3.5" class="pip" style="--i:2" />
        </g>
      ) : null}

      {kind === "pulse" ? (
        <g>
          <rect x="140" y="28" width="120" height="244" rx="18" class="win" />
          <rect x="182" y="38" width="36" height="6" rx="3" class="dot" />
          <circle cx="200" cy="112" r="40" fill="none" stroke="var(--paper-3)" stroke-width="10" />
          <circle cx="200" cy="112" r="40" fill="none" stroke="var(--accent)" stroke-width="10" stroke-linecap="round" pathLength="100" stroke-dasharray="72 100" transform="rotate(-90 200 112)" class="ring" />
          <rect x="186" y="106" width="28" height="7" rx="3.5" class="txt-d" />
          <rect x="160" y="172" width="80" height="18" rx="9" class="bub" />
          <rect x="160" y="198" width="80" height="18" rx="9" class="bub" />
          <rect x="160" y="224" width="52" height="18" rx="9" class="bub-a" />
          <rect x="168" y="178" width="40" height="6" rx="3" class="txt" />
          <rect x="168" y="204" width="54" height="6" rx="3" class="txt" />
        </g>
      ) : null}

      {kind === "seo" ? (
        <g>
          <rect x="40" y="45" width="320" height="210" rx="4" class="win" />
          <line x1="40" y1="80" x2="360" y2="80" class="hair" />
          <circle cx="60" cy="62" r="3.5" class="dot" /><circle cx="76" cy="62" r="3.5" class="dot" /><circle cx="92" cy="62" r="3.5" class="dot" />
          <rect x="66" y="98" width="230" height="26" rx="13" class="bub" />
          <circle cx="282" cy="111" r="6" fill="none" stroke="var(--ink)" stroke-width="2" /><line x1="286" y1="115" x2="291" y2="120" class="hair" />
          <rect x="66" y="142" width="268" height="30" rx="3" class="bub-a" />
          <text x="78" y="162" font-family="var(--mono)" font-size="12" fill="var(--ink)">#1</text>
          <rect x="104" y="153" width="150" height="7" rx="3.5" fill="var(--ink)" opacity="0.7" />
          <rect x="66" y="186" width="210" height="7" rx="3.5" class="txt" />
          <rect x="66" y="200" width="150" height="6" rx="3" class="txt" opacity="0.6" />
          <rect x="66" y="222" width="190" height="7" rx="3.5" class="txt" />
          <path d="M300 236 L318 214 L330 222 L346 196" fill="none" stroke="var(--accent)" stroke-width="3" stroke-linecap="round" stroke-linejoin="round" />
          <path d="M338 196 L346 196 L346 204" fill="none" stroke="var(--accent)" stroke-width="3" stroke-linecap="round" stroke-linejoin="round" />
        </g>
      ) : null}

      {kind === "trading" ? (
        <g>
          <rect x="26" y="118" width="348" height="84" class="band" />
          <line x1="26" y1="118" x2="374" y2="118" class="edge" />
          <line x1="26" y1="202" x2="374" y2="202" class="edge" />
          <path class="curve a" d="M26 216 C 76 188, 108 206, 148 156 S 226 126, 268 146 S 336 96, 374 110" />
          <path class="curve b" d="M26 232 C 78 218, 112 178, 152 190 S 234 168, 276 124 S 342 134, 374 88" />
          <circle cx="150" cy="172" r="6" class="mark" />
          <circle cx="272" cy="134" r="6" class="mark exit" />
        </g>
      ) : null}

      {kind === "sentiment" ? (
        <g>
          <g class="words">
            <rect x="48" y="66" width="104" height="14" rx="7" style="--i:0" />
            <rect x="164" y="66" width="66" height="14" rx="7" class="hi" style="--i:1" />
            <rect x="242" y="66" width="88" height="14" rx="7" style="--i:2" />
            <rect x="48" y="98" width="70" height="14" rx="7" style="--i:3" />
            <rect x="130" y="98" width="128" height="14" rx="7" class="hi" style="--i:4" />
            <rect x="270" y="98" width="52" height="14" rx="7" style="--i:5" />
            <rect x="48" y="130" width="120" height="14" rx="7" style="--i:6" />
            <rect x="180" y="130" width="60" height="14" rx="7" style="--i:7" />
            <rect x="252" y="130" width="82" height="14" rx="7" class="hi" style="--i:8" />
          </g>
          <g class="bars">
            <rect x="60" y="248" width="46" height="12" rx="2" />
            <rect x="60" y="222" width="118" height="12" rx="2" class="hi" />
            <rect x="60" y="196" width="80" height="12" rx="2" />
          </g>
          <line x1="52" y1="186" x2="52" y2="272" class="axis" />
        </g>
      ) : null}
    </svg>
  )}
  <span class="idx">{String(index).padStart(2, "0")}</span>
</div>

<style>
  .cover {
    position: relative; aspect-ratio: 4 / 3; overflow: hidden;
    background: var(--paper-2); border: 1px solid var(--rule);
  }
  .cover svg, .photo { width: 100%; height: 100%; display: block; }
  .photo { object-fit: cover; filter: grayscale(1) contrast(1.05); transition: filter 0.8s var(--ease), transform 1.2s var(--ease-out); }
  :global(.card):hover .photo { filter: none; transform: scale(1.04); }
  .cover svg { transition: transform 1.2s var(--ease-out); }
  :global(.card):hover .cover svg { transform: scale(1.05); }
  .idx { position: absolute; top: 0.7rem; left: 0.8rem; font-family: var(--mono); font-size: 0.6rem; color: var(--muted); }

  .win { fill: var(--paper); stroke: var(--ink); stroke-width: 1.5; }
  .ring { transition: stroke-dasharray 1.2s var(--ease-out); }
  .cover:hover .ring { stroke-dasharray: 96 100; }
  .hair { stroke: var(--ink); stroke-width: 1.5; }
  .dot { fill: var(--ink); }
  .bub { fill: var(--paper-3); }
  .bub-a { fill: var(--accent); }
  .txt { fill: var(--muted); }
  .txt-d { fill: var(--ink); opacity: 0.55; }
  .pip { fill: var(--ink); animation: blip 1.4s infinite; animation-delay: calc(var(--i) * 0.18s); }
  @keyframes blip { 0%, 60%, 100% { opacity: 0.25; transform: translateY(0); } 30% { opacity: 1; transform: translateY(-3px); } }

  .rig { stroke: var(--ink); stroke-width: 2.5; fill: none; stroke-linecap: round; stroke-linejoin: round; }
  .joints circle { fill: var(--accent); }
  .wave {
    stroke: var(--accent); stroke-width: 2.5; fill: none; stroke-linecap: round; stroke-linejoin: round;
    stroke-dasharray: 620; stroke-dashoffset: 620; animation: draw 3.4s var(--ease-io) infinite;
  }
  @keyframes draw { 0% { stroke-dashoffset: 620; } 55%, 100% { stroke-dashoffset: -620; } }

  .band { fill: var(--accent); opacity: 0.1; }
  .edge { stroke: var(--ink); opacity: 0.35; stroke-dasharray: 4 6; }
  .curve { fill: none; stroke-width: 2.5; stroke-linecap: round; stroke-dasharray: 700; animation: trace 2.6s var(--ease-out) forwards; }
  .curve.a { stroke: var(--muted); }
  .curve.b { stroke: var(--ink); animation-delay: 0.25s; }
  @keyframes trace { from { stroke-dashoffset: 700; } to { stroke-dashoffset: 0; } }
  .mark { fill: var(--paper); stroke: var(--accent); stroke-width: 2.5; }
  .mark.exit { stroke: var(--ink); }

  .words rect { fill: var(--paper-3); animation: fade 4.2s ease-in-out infinite; animation-delay: calc(var(--i) * 0.22s); }
  .words rect.hi { fill: var(--accent); }
  @keyframes fade { 0%, 100% { opacity: 0.45; } 50% { opacity: 1; } }
  .bars rect { fill: var(--paper-3); }
  .bars rect.hi { fill: var(--ink); }
  .axis { stroke: var(--ink); stroke-width: 2; }
</style>