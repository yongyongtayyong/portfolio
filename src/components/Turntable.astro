---
import vinyl from '../data/vinyl.json';
const ytId = (u = "") => (u.match(/(?:youtu\.be\/|v=|embed\/|shorts\/)([\w-]{11})/) || [])[1] || "";
const artists = vinyl.map((a) => ({ n: a.artist, t: a.title, c: a.color, yt: ytId(a.youtube), search: "https://www.youtube.com/results?search_query=" + encodeURIComponent(a.artist + " " + a.title) }));
---
<div class="deck-unit">
  <div class="deck">
    <div class="platter">
      <div class="record" id="rec">
        <div class="rlabel"><span id="rlText">—</span></div>
        <div class="spindle"></div>
      </div>
    </div>

    <div class="arm" id="arm">
      <div class="pivot"></div>
      <div class="tube"></div>
      <div class="head"></div>
    </div>
  </div>

  <div class="nowbar">
    <p class="np-lab">Now playing</p>
    <p class="np-track" id="npTrack">Nothing — drop a record on</p>
    <div class="np-player" id="npPlayer" hidden><div id="ytMount"></div></div>
    <a class="np-link" id="npLink" href="#" target="_blank" rel="noopener" hidden>Listen on YouTube ↗</a>
  </div>

  <div class="crate">
    {artists.map((x) => (
      <button class="sleeve" type="button" style={"--c:" + x.c}
        data-n={x.n} data-t={x.t} data-c={x.c} data-yt={x.yt} data-search={x.search}>
        <span class="disc"></span>
        <span class="jacket">
          <span class="j-mark"></span>
          <span class="j-name">{x.n}</span>
          <span class="j-track">{x.t}</span>
        </span>
      </button>
    ))}
  </div>

  <p class="foot">Pick a record. It plays from YouTube.</p>
</div>

<style>
  .deck-unit { margin-top: 3rem; display: grid; grid-template-columns: minmax(0, 5fr) minmax(0, 7fr); gap: var(--pad); align-items: center; }
  @media (max-width: 860px) { .deck-unit { grid-template-columns: 1fr; } }
  .deck { position: relative; width: 100%; max-width: 440px; aspect-ratio: 1 / 1; margin: 0 auto; background: linear-gradient(158deg, #24221e 0%, #161512 60%, #0f0e0c 100%); box-shadow: 0 40px 60px -30px rgba(0, 0, 0, 0.55), 0 0 0 1px var(--ink); grid-row: span 3; }
  .platter { position: absolute; left: 7%; top: 13%; width: 64%; height: 64%; border-radius: 50%; background: #131210; border: 1px solid #2c2a25; box-shadow: inset 0 0 34px rgba(0, 0, 0, 0.9); display: grid; place-items: center; }
  .record { position: relative; width: 93%; height: 93%; border-radius: 50%; display: grid; place-items: center; background: repeating-radial-gradient(circle at 50% 50%, #0c0b0a 0 2px, #171614 2px 4px); box-shadow: 0 5px 24px rgba(0, 0, 0, 0.8); }
  .record::after { content: ""; position: absolute; inset: 0; border-radius: 50%; background: conic-gradient(from 0deg, rgba(255,250,235,0.12), transparent 22%, rgba(255,250,235,0.05) 48%, transparent 72%, rgba(255,250,235,0.1) 100%); }
  /* spin up like a real platter (quadratic ease-in for one turn, then constant) */
  .record.playing { animation: spinup 3.8s cubic-bezier(0.333, 0, 0.667, 0.333) forwards, spin 1.9s linear 3.8s infinite; }
  @keyframes spinup { from { transform: rotate(var(--a0, 0deg)); } to { transform: rotate(calc(var(--a0, 0deg) + 360deg)); } }
  @keyframes spin { from { transform: rotate(var(--a0, 0deg)); } to { transform: rotate(calc(var(--a0, 0deg) + 360deg)); } }
  .rlabel { position: relative; z-index: 2; width: 42%; height: 42%; border-radius: 50%; background: var(--c, #3a3833); display: grid; place-items: center; text-align: center; padding: 6%; transition: background 0.6s var(--ease); }
  .rlabel span { font-family: var(--mono); font-size: 0.55rem; font-weight: 500; text-transform: uppercase; color: #121211; line-height: 1.25; }
  .spindle { position: absolute; z-index: 3; width: 7px; height: 7px; border-radius: 50%; background: #d6d2c6; }
  .arm { position: absolute; left: 77%; top: 11%; width: 14px; height: 44%; transform-origin: 7px 7px; transform: rotate(24deg); transition: transform 1.1s var(--ease-io); z-index: 4; }
  .arm.on { transform: rotate(-20deg); }
  .pivot { position: absolute; top: 0; left: 0; width: 14px; height: 14px; border-radius: 50%; background: #4a4740; box-shadow: 0 0 0 3px #25231f, 0 2px 6px rgba(0,0,0,0.6); }
  .tube { position: absolute; top: 12px; left: 5.5px; width: 3px; height: calc(100% - 26px); background: linear-gradient(#a7a294, #4a4740); border-radius: 2px; }
  .head { position: absolute; bottom: 0; left: 2px; width: 10px; height: 16px; border-radius: 1px; background: var(--accent); box-shadow: 0 2px 5px rgba(0,0,0,0.6); }
  .nowbar { border-top: 1px solid var(--ink); padding-top: 1rem; }
  .np-lab { font-family: var(--mono); font-size: 0.72rem; text-transform: uppercase; color: var(--muted); margin: 0; }
  .np-track { font-family: var(--display); font-weight: 600; font-size: clamp(1.8rem, 3.6vw, 3.2rem); letter-spacing: -0.045em; margin: 0.5rem 0 0; line-height: 0.95; }
  .np-player { margin-top: 1rem; width: 100%; max-width: 420px; aspect-ratio: 16 / 9; min-height: 200px; background: #000; border: 1px solid var(--ink); }
  .np-player :global(iframe) { width: 100%; height: 100%; display: block; }
  .np-link { display: inline-block; margin-top: 0.9rem; font-family: var(--mono); font-size: 0.72rem; text-transform: uppercase; }
  .crate { display: grid; grid-template-columns: repeat(5, minmax(0, 1fr)); gap: 0.8rem; }
  @media (max-width: 520px) { .crate { grid-template-columns: repeat(3, minmax(0, 1fr)); } }
  .sleeve { cursor: pointer; position: relative; box-sizing: border-box; aspect-ratio: 1 / 1; background: none; border: none; padding: 0; color: #121211; }
  .disc { position: absolute; top: 5%; right: 5%; width: 90%; height: 90%; border-radius: 50%; background: repeating-radial-gradient(circle at 50% 50%, #0c0b0a 0 2px, #181715 2px 4px); transform: translateX(0) rotate(0deg); transition: transform 0.7s var(--ease-back); }
  .sleeve:hover .disc, .sleeve.active .disc { transform: translateX(34%) rotate(40deg); }
  .jacket { position: absolute; inset: 0; z-index: 2; padding: 0.6rem; display: flex; flex-direction: column; justify-content: flex-end; gap: 0.15rem; text-align: left; background: var(--c); border: 1px solid var(--ink); transition: transform 0.55s var(--ease-back); }
  .sleeve:hover .jacket { transform: translateY(-6px) rotate(-1.5deg); }
  .sleeve.active .jacket { box-shadow: inset 0 0 0 3px #121211; }
  .j-mark { width: 14px; height: 14px; border-radius: 50%; border: 2px solid #121211; margin-bottom: auto; flex: 0 0 auto; }
  .j-name { font-family: var(--display); font-weight: 600; font-size: clamp(0.8rem, 1.3vw, 1.05rem); letter-spacing: -0.03em; line-height: 1; }
  .j-track { font-family: var(--mono); font-size: 0.55rem; line-height: 1.25; opacity: 0.75; }
  .foot { margin: 0; font-family: var(--mono); font-size: 0.68rem; text-transform: uppercase; color: var(--muted); }
  @media (prefers-reduced-motion: reduce) { .record.playing { animation: none; } .arm { transition: none; } }
</style>

<script>
  // The real song, through YouTube's player (kept visible, as YouTube requires).
  const ARM_MS = 1100;   // must match the .arm transition
  const rec = document.getElementById("rec");
  const arm = document.getElementById("arm");
  const rlText = document.getElementById("rlText");
  const npTrack = document.getElementById("npTrack");
  const npLink = document.getElementById("npLink");
  const npPlayer = document.getElementById("npPlayer");
  const sleeves = document.querySelectorAll(".sleeve");
  let token = 0, timers = [], player = null, apiReady = null;

  const clearTimers = () => { timers.forEach(clearTimeout); timers = []; };
  const angleNow = () => {
    if (!rec) return 0;
    const m = getComputedStyle(rec).transform;
    const v = m && m !== "none" && m.match(/matrix\(([^)]+)\)/);
    if (!v) return 0;
    const [a, b] = v[1].split(",").map(Number);
    return (Math.atan2(b, a) * 180) / Math.PI;
  };
  const coast = () => {
    if (!rec || !rec.classList.contains("playing")) return;
    const a = angleNow();
    rec.classList.remove("playing");
    rec.style.transition = "none";
    rec.style.transform = "rotate(" + a + "deg)";
    rec.getBoundingClientRect();
    rec.style.transition = "transform 2.2s cubic-bezier(0.15, 0.6, 0.3, 1)";
    rec.style.transform = "rotate(" + (a + 220) + "deg)";
  };
  const spin = () => {
    if (!rec || rec.classList.contains("playing")) return;
    const a = angleNow();
    rec.style.transition = "none";
    rec.style.transform = "";
    rec.style.setProperty("--a0", a + "deg");
    rec.classList.add("playing");
  };

  const loadApi = () => apiReady || (apiReady = new Promise((res) => {
    if (window.YT && window.YT.Player) return res();
    const prev = window.onYouTubeIframeAPIReady;
    window.onYouTubeIframeAPIReady = () => { prev && prev(); res(); };
    const s = document.createElement("script");
    s.src = "https://www.youtube.com/iframe_api";
    document.head.append(s);
  }));
  const play = async (id, mine) => {
    await loadApi();
    if (mine !== token) return;
    if (npPlayer) npPlayer.hidden = false;
    if (!player) {
      player = new YT.Player("ytMount", {
        videoId: id, playerVars: { autoplay: 1, rel: 0, playsinline: 1, modestbranding: 1 },
        events: {
          onReady: (e) => e.target.playVideo(),
          onStateChange: (e) => {
            if (e.data === YT.PlayerState.PLAYING) { spin(); arm?.classList.add("on"); }
            if (e.data === YT.PlayerState.PAUSED) coast();
            if (e.data === YT.PlayerState.ENDED) stop();
          },
        },
      });
    } else player.loadVideoById(id);
  };

  const stop = () => {
    token++;
    clearTimers();
    sleeves.forEach((s) => s.classList.remove("active"));
    coast();
    if (rec) rec.style.setProperty("--c", "#3a3833");
    arm?.classList.remove("on");
    if (rlText) rlText.textContent = "—";
    if (npTrack) npTrack.textContent = "Nothing — drop a record on";
    if (npLink) npLink.hidden = true;
    try { player && player.pauseVideo(); } catch (e) {}
  };

  sleeves.forEach((s) => {
    s.addEventListener("click", () => {
      if (s.classList.contains("active")) { stop(); return; }
      const mine = ++token;
      clearTimers();
      sleeves.forEach((o) => o.classList.remove("active"));
      s.classList.add("active");
      const name = s.dataset.n || "", track = s.dataset.t || "", id = s.dataset.yt || "";
      coast();
      try { player && player.pauseVideo(); } catch (e) {}
      if (rec) rec.style.setProperty("--c", s.dataset.c || "#d4b06a");
      arm?.classList.remove("on");
      if (rlText) rlText.textContent = track;
      if (npTrack) npTrack.textContent = track + " — " + name;
      if (npLink) { npLink.href = id ? "https://www.youtube.com/watch?v=" + id : s.dataset.search || "#"; npLink.hidden = false; }
      if (id) loadApi(); // start fetching the player while the arm moves
      requestAnimationFrame(() => { if (mine === token) arm?.classList.add("on"); });
      timers.push(setTimeout(() => {
        if (mine !== token) return;
        if (id) play(id, mine); else spin();
      }, ARM_MS));
    });
  });
</script>
