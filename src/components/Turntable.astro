---
const artists = [
  { n: "Cody Fry",    t: "Photograph",                             c: "#d4b06a", ch: [261.63, 329.63, 392.00, 493.88] },
  { n: "Bruno Major", t: "Regent's Park",                          c: "#9aa88f", ch: [174.61, 220.00, 261.63, 329.63] },
  { n: "Bruno Mars",  t: "Leave The Door Open",                    c: "#c08e6f", ch: [146.83, 220.00, 261.63, 329.63] },
  { n: "The 1975",    t: "It's Not Living (If It's Not With You)", c: "#e8e2d6", ch: [220.00, 277.18, 329.63, 415.30] },
  { n: "Hongjoin",    t: "Komorebi",                               c: "#8d94a8", ch: [196.00, 246.94, 293.66, 369.99] },
].map((a) => ({ ...a, link: "https://www.youtube.com/results?search_query=" + encodeURIComponent(a.n + " " + a.t) }));
---
<div class="deck-unit">
  <div class="deck">
    <div class="platter">
      <div class="record" id="rec">
        <div class="rlabel"><span id="rlText">—</span></div>
        <div class="spindle"></div>
      </div>
    </div>

    <div class="arm" id="arm">
      <div class="pivot"></div>
      <div class="tube"></div>
      <div class="head"></div>
    </div>
  </div>

  <div class="nowbar">
    <p class="np-lab">Now playing</p>
    <p class="np-track" id="npTrack">Nothing — drop a record on</p>
    <a class="np-link" id="npLink" href="#" target="_blank" rel="noopener" hidden>Hear the real thing ↗</a>
  </div>

  <div class="crate">
    {artists.map((x) => (
      <button class="sleeve" type="button" style={"--c:" + x.c}
        data-n={x.n} data-t={x.t} data-c={x.c} data-link={x.link} data-ch={x.ch.join(",")}>
        <span class="disc"></span>
        <span class="jacket">
          <span class="j-mark"></span>
          <span class="j-name">{x.n}</span>
          <span class="j-track">{x.t}</span>
        </span>
      </button>
    ))}
  </div>

  <p class="foot">Sound is a short original chord in each track's key — not the recording.</p>
</div>

<style>
  .deck-unit { margin-top: 3.5rem; }

  /* fixed square canvas — everything inside is positioned against it */
  .deck {
    position: relative;
    width: 100%;
    max-width: 420px;
    aspect-ratio: 1 / 1;
    margin: 0 auto;
    border-radius: 3px;
    background: linear-gradient(158deg, #201a12 0%, #16120d 55%, #100d0a 100%);
    border: 1px solid var(--rule);
    box-shadow: 0 34px 78px rgba(0, 0, 0, 0.72);
  }

  .platter {
    position: absolute;
    left: 7%; top: 13%;
    width: 64%; height: 64%;
    border-radius: 50%;
    background: #171310;
    border: 1px solid #2a2319;
    box-shadow: inset 0 0 34px rgba(0, 0, 0, 0.9);
    display: grid;
    place-items: center;
  }

  .record {
    position: relative;
    width: 93%; height: 93%;
    border-radius: 50%;
    display: grid;
    place-items: center;
    background: repeating-radial-gradient(circle at 50% 50%, #0d0b09 0 2px, #171310 2px 4px);
    box-shadow: 0 5px 24px rgba(0, 0, 0, 0.8);
  }
  .record::after {
    content: "";
    position: absolute; inset: 0;
    border-radius: 50%;
    background: conic-gradient(from 0deg,
      rgba(255,245,220,0.10), transparent 22%,
      rgba(255,245,220,0.05) 48%, transparent 72%,
      rgba(255,245,220,0.09) 100%);
  }
  .record.playing { animation: spin 1.9s linear infinite; }
  @keyframes spin { to { transform: rotate(360deg); } }

  .rlabel {
    position: relative; z-index: 2;
    width: 42%; height: 42%;
    border-radius: 50%;
    background: var(--c, #332c22);
    display: grid; place-items: center;
    text-align: center; padding: 6%;
    transition: background 0.6s var(--ease);
  }
  .rlabel span {
    font-family: var(--sans); font-size: 0.56rem; font-weight: 600;
    letter-spacing: 0.08em; text-transform: uppercase;
    color: #0c0a08; line-height: 1.25;
  }
  .spindle {
    position: absolute; z-index: 3;
    width: 7px; height: 7px; border-radius: 50%;
    background: #cfc9bc;
  }

  /* tonearm: pivots at its top-left corner */
  .arm {
    position: absolute;
    left: 77%; top: 11%;
    width: 14px; height: 44%;
    transform-origin: 7px 7px;
    transform: rotate(24deg);
    transition: transform 1.1s var(--ease);
    z-index: 4;
  }
  .arm.on { transform: rotate(-20deg); }

  .pivot {
    position: absolute; top: 0; left: 0;
    width: 14px; height: 14px; border-radius: 50%;
    background: #463e33;
    box-shadow: 0 0 0 3px #241e17, 0 2px 6px rgba(0,0,0,0.6);
  }
  .tube {
    position: absolute; top: 12px; left: 5.5px;
    width: 3px; height: calc(100% - 26px);
    background: linear-gradient(#8a8072, #463e33);
    border-radius: 2px;
  }
  .head {
    position: absolute; bottom: 0; left: 2px;
    width: 10px; height: 16px; border-radius: 1px;
    background: var(--accent);
    box-shadow: 0 2px 5px rgba(0,0,0,0.6);
  }

  .nowbar { text-align: center; margin-top: 2.75rem; }
  .np-lab {
    font-family: var(--sans); font-size: 0.68rem; font-weight: 500;
    letter-spacing: 0.26em; text-transform: uppercase; color: var(--muted); margin: 0;
  }
  .np-track {
    font-family: var(--serif); font-size: clamp(1.4rem, 3vw, 1.95rem);
    font-weight: 600; font-style: italic; margin: 0.5rem 0 0; line-height: 1.25;
  }
  .np-link {
    display: inline-block; margin-top: 0.9rem;
    font-family: var(--sans); font-size: 0.68rem; font-weight: 500;
    letter-spacing: 0.2em; text-transform: uppercase;
  }

  .crate {
    display: grid;
    grid-template-columns: repeat(5, minmax(0, 1fr));
    gap: 1.25rem; margin-top: 3.5rem;
  }
  @media (max-width: 860px) { .crate { grid-template-columns: repeat(3, minmax(0, 1fr)); } }
  @media (max-width: 520px) { .crate { grid-template-columns: repeat(2, minmax(0, 1fr)); } }

  .sleeve {
    cursor: pointer; position: relative; box-sizing: border-box;
    aspect-ratio: 1 / 1; background: none; border: none; padding: 0;
  }
  .disc {
    position: absolute; top: 6%; right: 6%;
    width: 88%; height: 88%; border-radius: 50%;
    background: repeating-radial-gradient(circle at 50% 50%, #0c0a08 0 2px, #16120e 2px 4px);
    transform: translateX(0) rotate(0deg);
    transition: transform 0.6s var(--ease);
  }
  .sleeve:hover .disc, .sleeve.active .disc { transform: translateX(28%) rotate(24deg); }

  .jacket {
    position: absolute; inset: 0; z-index: 2;
    border-radius: 2px; padding: 0.9rem;
    display: flex; flex-direction: column; justify-content: flex-end;
    gap: 0.1rem; text-align: left;
    background: linear-gradient(150deg, color-mix(in srgb, var(--c) 24%, #16120e), #0e0c09);
    border: 1px solid color-mix(in srgb, var(--c) 34%, transparent);
    transition: transform 0.5s var(--ease), border-color 0.5s var(--ease);
  }
  .sleeve:hover .jacket { transform: translateY(-6px); }
  .sleeve.active .jacket { border-color: var(--c); }
  .j-mark {
    width: 16px; height: 16px; border-radius: 50%;
    border: 2px solid var(--c); margin-bottom: 0.5rem; flex: 0 0 auto;
  }
  .j-name {
    font-family: var(--serif); font-size: 1.1rem; font-weight: 600;
    color: var(--ink); line-height: 1.15;
  }
  .j-track {
    font-family: var(--sans); font-size: 0.6rem; font-weight: 400;
    letter-spacing: 0.05em; color: var(--muted); line-height: 1.3;
  }

  .foot {
    margin-top: 1.75rem; text-align: center;
    font-family: var(--sans); font-size: 0.66rem; font-weight: 400;
    letter-spacing: 0.14em; text-transform: uppercase; color: #5a5145;
  }

  @media (prefers-reduced-motion: reduce) {
    .record.playing { animation: none; }
    .arm { transition: none; }
  }
</style>

<script>
  const ARM_MS = 1100;   // must match the .arm transition duration

  const rec = document.getElementById("rec");
  const arm = document.getElementById("arm");
  const rlText = document.getElementById("rlText");
  const npTrack = document.getElementById("npTrack");
  const npLink = document.getElementById("npLink");
  const sleeves = document.querySelectorAll(".sleeve");

  let ctx = null, master = null, crackleGain = null;
  let token = 0;
  let timers = [];

  const clearTimers = () => { timers.forEach(clearTimeout); timers = []; };

  const audio = () => {
    if (ctx) return ctx;
    const AC = window.AudioContext || window.webkitAudioContext;
    if (!AC) return null;
    ctx = new AC();
    master = ctx.createGain();
    master.gain.value = 0.5;
    master.connect(ctx.destination);

    const len = ctx.sampleRate * 2;
    const buf = ctx.createBuffer(1, len, ctx.sampleRate);
    const d = buf.getChannelData(0);
    for (let i = 0; i < len; i++) {
      d[i] = Math.random() < 0.0009 ? (Math.random() * 2 - 1) * 0.9 : (Math.random() * 2 - 1) * 0.02;
    }
    const src = ctx.createBufferSource();
    src.buffer = buf;
    src.loop = true;
    const hp = ctx.createBiquadFilter();
    hp.type = "highpass";
    hp.frequency.value = 1400;
    crackleGain = ctx.createGain();
    crackleGain.gain.value = 0;
    src.connect(hp).connect(crackleGain).connect(master);
    src.start();
    return ctx;
  };

  const arpeggio = (freqs) => {
    const c = audio();
    if (!c) return;
    freqs.forEach((f, i) => {
      const t0 = c.currentTime + i * 0.17;
      const osc = c.createOscillator();
      const g = c.createGain();
      const lp = c.createBiquadFilter();
      osc.type = "triangle";
      osc.frequency.value = f;
      lp.type = "lowpass";
      lp.frequency.value = 2200;
      g.gain.setValueAtTime(0, t0);
      g.gain.linearRampToValueAtTime(0.15, t0 + 0.04);
      g.gain.exponentialRampToValueAtTime(0.0001, t0 + 2.4);
      osc.connect(lp).connect(g).connect(master);
      osc.start(t0);
      osc.stop(t0 + 2.6);
    });
  };

  const stop = () => {
    token++;
    clearTimers();
    sleeves.forEach((s) => s.classList.remove("active"));
    if (rec) { rec.classList.remove("playing"); rec.style.setProperty("--c", "#332c22"); }
    if (arm) arm.classList.remove("on");
    if (rlText) rlText.textContent = "—";
    if (npTrack) npTrack.textContent = "Nothing — drop a record on";
    if (npLink) npLink.hidden = true;
    if (crackleGain && ctx) crackleGain.gain.setTargetAtTime(0, ctx.currentTime, 0.2);
  };

  sleeves.forEach((s) => {
    s.addEventListener("click", () => {
      if (s.classList.contains("active")) { stop(); return; }

      token++;
      const mine = token;
      clearTimers();

      sleeves.forEach((o) => o.classList.remove("active"));
      s.classList.add("active");

      const c = audio();
      if (c && c.state === "suspended") c.resume();

      const name = s.getAttribute("data-n") || "";
      const track = s.getAttribute("data-t") || "";
      const chord = (s.getAttribute("data-ch") || "").split(",").map(Number);

      // silence and lift while the arm repositions
      if (rec) {
        rec.classList.remove("playing");
        rec.style.setProperty("--c", s.getAttribute("data-c") || "#d4b06a");
      }
      if (crackleGain && ctx) crackleGain.gain.setTargetAtTime(0, ctx.currentTime, 0.08);
      if (arm) arm.classList.remove("on");

      if (rlText) rlText.textContent = track;
      if (npTrack) npTrack.textContent = track + " — " + name;
      if (npLink) { npLink.href = s.getAttribute("data-link") || "#"; npLink.hidden = false; }

      // next frame: start the swing
      requestAnimationFrame(() => {
        if (mine !== token) return;
        if (arm) arm.classList.add("on");
      });

      // needle lands: platter turns, crackle in
      timers.push(setTimeout(() => {
        if (mine !== token) return;
        if (rec) rec.classList.add("playing");
        if (crackleGain && ctx) crackleGain.gain.setTargetAtTime(0.45, ctx.currentTime, 0.25);
      }, ARM_MS));

      // a beat of groove noise, then the chord
      timers.push(setTimeout(() => {
        if (mine !== token) return;
        arpeggio(chord);
      }, ARM_MS + 420));
    });
  });
</script>