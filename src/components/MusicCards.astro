---
import performances from '../data/performances.json';
const count = (k) => performances.filter((p) => p.instrument === k).length;
const cards = [
  { key: "keys", name: "Keys", sub: "Piano, synths, the band's keyboard", n: count("keys") },
  { key: "strings", name: "Strings", sub: "Viola and violin", n: count("strings") },
];
---
<div class="mc2">
  {cards.map((c) => (
    <a class={"mcard " + c.key} href={"/music#" + c.key} data-wipe={c.name} data-cursor="Watch">
      <span class="mc-top mono"><span>{c.n ? `${c.n} ${c.n === 1 ? "performance" : "performances"}` : "Performances"}</span><span class="mc-go">→</span></span>
      {c.key === "keys" ? (
        <svg class="mc-art" viewBox="0 0 280 120" aria-hidden="true">
          {Array.from({ length: 14 }, (_, i) => <rect class="wk" x={i * 20} y="0" width="19" height="120" rx="2" style={"--i:" + i} />)}
          {[0, 1, 3, 4, 5, 7, 8, 10, 11, 12].map((i) => <rect class="bk" x={i * 20 + 13} y="0" width="13" height="72" rx="2" style={"--i:" + i} />)}
        </svg>
      ) : (
        <svg class="mc-art" viewBox="0 0 280 120" aria-hidden="true">
          {[24, 48, 72, 96].map((y, i) => <path class="st" d={`M0 ${y} Q140 ${y} 280 ${y}`} style={"--i:" + i} />)}
          <g class="bow"><line x1="70" y1="-6" x2="210" y2="126" class="bow-s" /><line x1="78" y1="-6" x2="218" y2="126" class="bow-h" /></g>
        </svg>
      )}
      <span class="mc-name">{c.name}</span>
      <span class="mc-sub mono muted">{c.sub}</span>
    </a>
  ))}
</div>

<style>
  .mc2 { display: grid; grid-template-columns: 1fr 1fr; gap: var(--pad); }
  @media (max-width: 600px) { .mc2 { grid-template-columns: 1fr; } }
  .mcard { position: relative; isolation: isolate; overflow: hidden; display: flex; flex-direction: column; gap: 0.5rem; padding: 1rem; border: 1px solid var(--ink); text-decoration: none; transition: color 0.5s var(--ease); }
  .mcard::before { content: ""; position: absolute; inset: 0; z-index: -1; background: var(--ink); clip-path: circle(0% at 100% 0%); transition: clip-path 0.8s var(--ease-io); }
  .mcard:hover { color: var(--paper); }
  .mcard:hover::before { clip-path: circle(150% at 100% 0%); }
  .mc-top { display: flex; justify-content: space-between; font-size: 0.72rem; text-transform: uppercase; }
  .mc-go { transition: transform 0.6s var(--ease-back); }
  .mcard:hover .mc-go { transform: translateX(4px) rotate(-45deg); }
  .mc-art { width: 100%; height: auto; margin: 0.6rem 0 0.4rem; overflow: visible; }
  .mc-name { font-family: var(--display); font-weight: 600; font-size: clamp(2.4rem, 5vw, 4rem); letter-spacing: -0.055em; line-height: 0.9; }
  .mc-sub { font-size: 0.72rem; text-transform: uppercase; }
  .mcard:hover .mc-sub { color: inherit; opacity: 0.65; }

  .wk { fill: var(--paper); stroke: currentColor; stroke-width: 1.2; transform-box: fill-box; transform-origin: 50% 0; }
  .bk { fill: currentColor; transform-box: fill-box; transform-origin: 50% 0; }
  .mcard:hover .wk, .mcard:hover .bk { animation: press 1.6s var(--ease-io) infinite; animation-delay: calc(var(--i) * 70ms); }
  .mcard:hover .wk { fill: var(--paper-3); }
  @keyframes press { 0%, 30%, 100% { transform: none; } 12% { transform: scaleY(0.96); fill: var(--accent); } }
  .st { fill: none; stroke: currentColor; stroke-width: 1.6; }
  .mcard:hover .st:nth-child(1) { animation-name: tw1; } .mcard:hover .st:nth-child(2) { animation-name: tw2; }
  .mcard:hover .st:nth-child(3) { animation-name: tw3; } .mcard:hover .st:nth-child(4) { animation-name: tw4; }
  @keyframes tw1 { 0%, 100% { d: path("M0 24 Q140 24 280 24"); } 25% { d: path("M0 24 Q140 30 280 24"); } 50% { d: path("M0 24 Q140 19 280 24"); } 75% { d: path("M0 24 Q140 26 280 24"); } }
  @keyframes tw2 { 0%, 100% { d: path("M0 48 Q140 48 280 48"); } 25% { d: path("M0 48 Q140 54 280 48"); } 50% { d: path("M0 48 Q140 43 280 48"); } 75% { d: path("M0 48 Q140 50 280 48"); } }
  @keyframes tw3 { 0%, 100% { d: path("M0 72 Q140 72 280 72"); } 25% { d: path("M0 72 Q140 78 280 72"); } 50% { d: path("M0 72 Q140 67 280 72"); } 75% { d: path("M0 72 Q140 74 280 72"); } }
  @keyframes tw4 { 0%, 100% { d: path("M0 96 Q140 96 280 96"); } 25% { d: path("M0 96 Q140 102 280 96"); } 50% { d: path("M0 96 Q140 91 280 96"); } 75% { d: path("M0 96 Q140 98 280 96"); } }
  .bow { transition: transform 0.9s var(--ease-io); }
  .mcard:hover .bow { animation: bowing 1.8s var(--ease-io) infinite alternate; }
  @keyframes bowing { from { transform: translateX(-40px); } to { transform: translateX(40px); } }
  .bow-s { stroke: currentColor; stroke-width: 4; stroke-linecap: round; }
  .bow-h { stroke: var(--accent); stroke-width: 1.5; }
  @media (prefers-reduced-motion: reduce) { .mcard:hover * { animation: none !important; } }
</style>
