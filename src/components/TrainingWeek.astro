---
const week = [
  { d: "Mon", t: "Upper", k: "upper" },
  { d: "Tue", t: "Lower", k: "lower" },
  { d: "Wed", t: "Run",   k: "run"   },
  { d: "Thu", t: "Upper", k: "upper" },
  { d: "Fri", t: "Lower", k: "lower" },
  { d: "Sat", t: "Run",   k: "run"   },
  { d: "Sun", t: "Rest",  k: "rest"  },
];
---
<div class="week">
  {week.map((day) => (
    <button class={"day k-" + day.k} type="button" disabled={day.k === "rest"}>
      <span class="d-lab">{day.d}</span>
      <svg viewBox="0 0 100 100" aria-hidden="true">
        {day.k === "upper" ? (
          <g class="a-upper">
            <line x1="26" y1="50" x2="74" y2="50" class="bar" />
            <rect x="17" y="35" width="10" height="30" rx="2" class="plate" />
            <rect x="73" y="35" width="10" height="30" rx="2" class="plate" />
          </g>
        ) : null}
        {day.k === "lower" ? (
          <g>
            <line x1="12" y1="68" x2="88" y2="68" class="depth" />
            <g class="a-lower">
              <line x1="30" y1="40" x2="70" y2="40" class="bar" />
              <rect x="19" y="22" width="12" height="36" rx="2" class="plate" />
              <rect x="69" y="22" width="12" height="36" rx="2" class="plate" />
            </g>
          </g>
        ) : null}
        {day.k === "run" ? (
          <g>
            <line x1="12" y1="82" x2="88" y2="82" class="ground" />
            <g class="streaks">
              <line x1="14" y1="44" x2="32" y2="44" style="--i:0" />
              <line x1="10" y1="58" x2="26" y2="58" style="--i:1" />
              <line x1="16" y1="72" x2="30" y2="72" style="--i:2" />
            </g>
            <circle cx="56" cy="70" r="8" class="a-run" />
          </g>
        ) : null}
        {day.k === "rest" ? (
          <g>
            <circle cx="50" cy="50" r="18" class="rest-ring" style="--i:0" />
            <circle cx="50" cy="50" r="18" class="rest-ring" style="--i:1" />
            <circle cx="50" cy="50" r="9" class="rest-core" />
          </g>
        ) : null}
      </svg>
      <span class="d-type">{day.t}</span>
      <span class="tick">✓</span>
    </button>
  ))}
</div>

<style>
  .week { display: grid; grid-template-columns: repeat(7, minmax(0, 1fr)); gap: 0; margin-top: 3rem; border-top: 1px solid var(--ink); border-left: 1px solid var(--ink); }
  @media (max-width: 780px) { .week { grid-template-columns: repeat(4, minmax(0, 1fr)); } }
  @media (max-width: 420px) { .week { grid-template-columns: repeat(2, minmax(0, 1fr)); } }
  .day { position: relative; isolation: isolate; cursor: pointer; box-sizing: border-box; border: 0; border-right: 1px solid var(--ink); border-bottom: 1px solid var(--ink); background: var(--paper); padding: 1rem 0.6rem 1.1rem; text-align: left; color: var(--ink); transition: color 0.45s var(--ease); overflow: hidden; }
  .day::before { content: ""; position: absolute; inset: 0; z-index: -1; background: var(--ink); clip-path: inset(100% 0 0 0); transition: clip-path 0.6s var(--ease-io); }
  .day:hover:not(:disabled) { color: var(--paper); }
  .day:hover:not(:disabled)::before { clip-path: inset(70% 0 0 0); }
  .day.done { color: var(--paper); }
  .day.done::before { clip-path: inset(0 0 0 0); }
  .day:disabled { cursor: not-allowed; background: var(--paper-2); color: var(--muted); }
  .k-rest.unlocked { color: var(--on-accent); background: var(--accent); }
  .tick { position: absolute; top: 0.7rem; right: 0.7rem; color: var(--accent); font-size: 0.9rem; opacity: 0; transform: scale(0.2) rotate(-90deg); transition: opacity 0.35s var(--ease), transform 0.6s var(--ease-back); }
  .day.done .tick, .k-rest.unlocked .tick { opacity: 1; transform: none; }
  .k-rest.unlocked .tick { color: var(--on-accent); }
  .d-lab { display: block; font-family: var(--mono); font-size: 0.68rem; text-transform: uppercase; opacity: 0.7; }
  .d-type { display: block; margin-top: 0.4rem; font-family: var(--display); font-weight: 600; font-size: 1.35rem; letter-spacing: -0.035em; line-height: 1; }
  .day svg { width: 100%; height: auto; display: block; margin: 0.6rem 0; transition: opacity 0.5s; }
  .bar { stroke: currentColor; stroke-width: 4; stroke-linecap: round; }
  .plate { fill: var(--accent); }
  .depth { stroke: currentColor; opacity: 0.4; stroke-width: 1.5; stroke-dasharray: 3 5; }
  .ground { stroke: currentColor; stroke-width: 1.5; }
  .a-upper { transform-box: view-box; transform-origin: 50px 50px; animation: pressUp 2.4s var(--ease-io) infinite; }
  @keyframes pressUp { 0%, 100% { transform: translateY(9px); } 12% { transform: translateY(11px); } 42%, 60% { transform: translateY(-11px); } }
  .a-lower { transform-box: view-box; transform-origin: 50px 40px; animation: squat 2.8s var(--ease-io) infinite; }
  @keyframes squat { 0%, 100% { transform: translateY(0); } 45%, 58% { transform: translateY(28px); } }
  .a-run { fill: var(--accent); transform-box: view-box; transform-origin: 56px 70px; animation: bounce 0.75s infinite; }
  @keyframes bounce { 0%, 100% { transform: translateY(0) scale(1.15, 0.85); animation-timing-function: var(--ease-out); } 12% { transform: translateY(-4px) scale(0.92, 1.08); } 50% { transform: translateY(-24px) scale(1); animation-timing-function: cubic-bezier(0.55, 0, 1, 0.45); } }
  .streaks line { stroke: currentColor; opacity: 0.5; stroke-width: 2.5; stroke-linecap: round; transform-box: view-box; transform-origin: center; animation: whoosh 0.75s linear infinite; animation-delay: calc(var(--i) * 0.12s); }
  @keyframes whoosh { 0% { opacity: 0; transform: translateX(-8px); } 40% { opacity: 0.6; } 100% { opacity: 0; transform: translateX(22px); } }
  .rest-core { fill: currentColor; opacity: 0.5; transform-box: view-box; transform-origin: 50px 50px; animation: breathe 4.5s ease-in-out infinite; }
  .k-rest.unlocked .rest-core { opacity: 1; }
  @keyframes breathe { 0%, 100% { transform: scale(0.85); } 50% { transform: scale(1.1); } }
  .rest-ring { fill: none; stroke: currentColor; stroke-width: 1; opacity: 0; transform-box: view-box; transform-origin: 50px 50px; animation: halo2 4.5s ease-out infinite; animation-delay: calc(var(--i) * 2.25s); }
  @keyframes halo2 { 0% { transform: scale(0.5); opacity: 0.5; } 70%, 100% { transform: scale(1.5); opacity: 0; } }
</style>

<script>
  const days = document.querySelectorAll(".day");
  const rest = document.querySelector(".k-rest");
  days.forEach((d) => {
    d.addEventListener("click", () => {
      if (d.hasAttribute("disabled")) return;
      d.classList.toggle("done");
      const n = document.querySelectorAll(".day.done").length;
      if (rest) rest.classList.toggle("unlocked", n === 6);
    });
  });
</script>