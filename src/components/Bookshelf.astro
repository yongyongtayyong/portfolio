---
const books = [
  { t: "Kafka on the Shore", a: "Haruki Murakami", y: "2002", c: "#6b7f8f", h: 232, note: "My favourite book of all time. I wish I could reread this for the first time. Murakami's writing is beautiful beyond words. I give this book 5 stars." },
  { t: "Someone Who Will Love You In All Your Damaged Glory", a: "Raphael Bob-Waksberg", y: "2019", c: "#a8798a", h: 248, note: "I laughed, I cried. The perfect blend of heartwarming drama and comedy. I give this book 4.5 stars" },
  { t: "Smoke Gets in Your Eyes", a: "Caitlin Doughty", y: "2014", c: "#8b8378", h: 214, note: "Such a real memoir of an industry that no one really talks about. Gave me an existential crisis for the next 2 years. I give this book 4 stars." },
  { t: "Dark Matter", a: "Blake Crouch", y: "2016", c: "#6d6480", h: 226, note: "I was never into Sci-Fi but I was absolutely hooked onto this book. The pages turned itself. I give this book 4 stars." },
  { t: "Taiwan Travelogue", a: "Yáng Shuāng-zǐ", y: "2020", c: "#c9a961", h: 240, note: "A slow burn but very character driven. The final chapter left me jaw dropped. I give this book 4 stars.", now: true },
];
---
<div class="shelf-unit">
  <div class="shelf">
    {books.map((b, i) => (
      <button class={b.now ? "book current" : "book"} type="button"
        data-t={b.t} data-a={b.a} data-y={b.y} data-note={b.note}
        style={"--c:" + b.c + "; --h:" + b.h + "px; --d:" + i * 60 + "ms"}>
        <span class="inner">
          <span class="face spine">
            <span class="sp-t">{b.t}</span>
            <span class="sp-a">{b.a}</span>
          </span>
          <span class="face bcover">
            <span class="cv-rule"></span>
            <span class="cv-t">{b.t}</span>
            <span class="cv-a">{b.a}</span>
            <span class="cv-y">{b.y}</span>
          </span>
        </span>
      </button>
    ))}
  </div>
  <div class="board"></div>

  <div class="detail">
    <p class="dt-t" id="bkT"></p>
    <p class="dt-a" id="bkA"></p>
    <p class="dt-n" id="bkN"></p>
  </div>
</div>

<style>
  .shelf-unit { margin-top: 3.5rem; }
  .shelf { display: flex; align-items: flex-end; justify-content: center; gap: 6px; min-height: 320px; padding: 0 0.5rem; perspective: 1400px; }
  .board { height: 10px; background: linear-gradient(#2e2820, #16120e); box-shadow: 0 16px 38px rgba(0,0,0,0.7); }

  .book {
    cursor: pointer; box-sizing: border-box; background: none; border: none; padding: 0;
    position: relative; flex: 0 0 auto; width: 48px; height: var(--h);
    transition: width 0.65s var(--ease), height 0.65s var(--ease), transform 0.65s var(--ease), margin 0.65s var(--ease);
  }
  .book.open { width: 178px; height: 256px; transform: translateY(-54px); margin: 0 12px; z-index: 5; }

  .inner { position: absolute; inset: 0; transform-style: preserve-3d; transition: transform 0.75s var(--ease); }
  .book.open .inner { transform: rotateY(180deg); }
  .face { position: absolute; inset: 0; backface-visibility: hidden; border-radius: 1px 3px 3px 1px; display: flex; overflow: hidden; }

  .spine {
    flex-direction: column; justify-content: space-between; align-items: center; padding: 1rem 0;
    writing-mode: vertical-rl; text-orientation: mixed;
    background: linear-gradient(90deg, color-mix(in srgb, var(--c) 48%, #100d0a) 0 3px, color-mix(in srgb, var(--c) 20%, #14110d) 3px 100%);
    border: 1px solid color-mix(in srgb, var(--c) 35%, transparent);
    box-shadow: inset -6px 0 14px rgba(0,0,0,0.5);
    transition: background 0.5s var(--ease);
  }
  .book:hover .spine { background: color-mix(in srgb, var(--c) 38%, #14110d); }
  .sp-t { font-family: var(--serif); font-size: 0.85rem; font-weight: 400; color: var(--ink); white-space: nowrap; overflow: hidden; text-overflow: ellipsis; max-height: 74%; }
  .sp-a { font-family: var(--sans); font-size: 0.5rem; letter-spacing: 0.14em; text-transform: uppercase; color: var(--muted); }
  .book.current .spine { box-shadow: inset -6px 0 14px rgba(0,0,0,0.5), 0 0 0 1px var(--accent); }

  .bcover {
    transform: rotateY(180deg); flex-direction: column; justify-content: flex-end;
    padding: 1.3rem; gap: 0.2rem; text-align: left;
    background: radial-gradient(120% 90% at 15% 8%, color-mix(in srgb, var(--c) 42%, transparent) 0%, transparent 60%), #100d0a;
    border: 1px solid color-mix(in srgb, var(--c) 45%, transparent);
  }
  .cv-rule { position: absolute; top: 1.3rem; left: 1.3rem; width: 30px; height: 1px; background: var(--c); }
  .cv-t { font-family: var(--serif); font-size: 1.1rem; font-weight: 400; line-height: 1.2; color: var(--ink); }
  .cv-a { font-size: 0.7rem; color: var(--muted); }
  .cv-y { font-family: var(--sans); font-size: 0.55rem; letter-spacing: 0.22em; color: var(--c); margin-top: 0.4rem; }

  .detail { margin-top: 3rem; max-width: 36rem; min-height: 7rem; }
  .dt-t { font-family: var(--serif); font-size: clamp(1.5rem, 3.2vw, 2.2rem); font-weight: 300; line-height: 1.2; margin: 0; }
  .dt-a { font-family: var(--sans); font-size: 0.6rem; letter-spacing: 0.24em; text-transform: uppercase; color: var(--muted); margin: 0.75rem 0 0; }
  .dt-n { color: var(--muted); margin-top: 1.25rem; }

  @media (max-width: 700px) {
    .shelf { overflow-x: auto; justify-content: flex-start; scrollbar-width: none; }
    .shelf::-webkit-scrollbar { display: none; }
    .book.open { width: 152px; }
  }
</style>

<script>
  const books = document.querySelectorAll(".book");
  const elT = document.getElementById("bkT");
  const elA = document.getElementById("bkA");
  const elN = document.getElementById("bkN");

  const show = (el) => {
    const was = el.classList.contains("open");
    books.forEach((b) => b.classList.remove("open"));
    if (was) {
      if (elT) elT.textContent = ""; if (elA) elA.textContent = ""; if (elN) elN.textContent = "";
      return;
    }
    el.classList.add("open");
    if (elT) elT.textContent = el.getAttribute("data-t") || "";
    if (elA) elA.textContent = (el.getAttribute("data-a") || "") + " · " + (el.getAttribute("data-y") || "");
    if (elN) elN.textContent = el.getAttribute("data-note") || "";
  };

  books.forEach((b) => b.addEventListener("click", () => show(b)));
  const current = document.querySelector(".book.current");
  if (current) show(current);
</script>