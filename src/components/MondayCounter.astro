<div class="mc">
  <span class="mc-n" id="mcN">—</span>
  <span class="mc-t">
    <span class="mc-lead" id="mcLead">Mondays until Christmas</span>
    <span class="mc-sub" id="mcSub">counting</span>
  </span>
</div>

<style>
  .mc {
    display: inline-flex; align-items: center; gap: 1.4rem;
    border: 1px solid var(--rule); border-radius: 2px;
    padding: 1rem 1.8rem; margin-top: 3rem; background: var(--panel);
    transition: border-color 0.6s var(--ease);
  }
  .mc:hover { border-color: var(--accent-dim); }
  .mc-n {
    font-family: var(--serif); font-size: 2.6rem; font-weight: 300;
    line-height: 1; color: var(--accent); font-variant-numeric: tabular-nums;
    min-width: 1.3ch; text-align: center;
  }
  .mc-t { display: flex; flex-direction: column; gap: 0.3rem; }
  .mc-lead { font-family: var(--serif); font-size: 1.1rem; font-weight: 400; color: var(--ink); line-height: 1.2; }
  .mc-sub {
    font-family: var(--sans); font-size: 0.58rem; font-weight: 400;
    letter-spacing: 0.24em; text-transform: uppercase; color: var(--muted);
  }
</style>

<script>
  const nEl = document.getElementById("mcN");
  const leadEl = document.getElementById("mcLead");
  const subEl = document.getElementById("mcSub");

  const today = new Date();
  today.setHours(0, 0, 0, 0);
  let xmas = new Date(today.getFullYear(), 11, 25);
  if (today > xmas) xmas = new Date(today.getFullYear() + 1, 11, 25);
  const isXmas = today.getMonth() === 11 && today.getDate() === 25;

  let mondays = 0;
  const cur = new Date(today);
  cur.setDate(cur.getDate() + 1);
  while (cur <= xmas) {
    if (cur.getDay() === 1) mondays++;
    cur.setDate(cur.getDate() + 1);
  }
  const days = Math.round((xmas - today) / 86400000);

  if (isXmas) {
    if (nEl) nEl.textContent = "0";
    if (leadEl) leadEl.textContent = "It's Christmas.";
    if (subEl) subEl.textContent = "Go eat something";
  } else {
    if (nEl) nEl.textContent = String(mondays);
    if (leadEl) leadEl.textContent = mondays === 1 ? "Monday until Christmas" : "Mondays until Christmas";
    if (subEl) subEl.textContent = (days === 1 ? "1 day" : days + " days") + " out";
  }
</script>