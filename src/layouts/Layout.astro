---
import "../styles/global.css";

const { title = "Tay Yong", description = "Tay Yong — mathematics, data and machine learning. New York." } = Astro.props;
const path = Astro.url.pathname;
const links = [
  { href: "/", label: "Index", on: path === "/" },
  { href: "/personal", label: "Personal", on: path.startsWith("/personal") },
  { href: "/food", label: "Food", on: path.startsWith("/food") },
];
const year = new Date().getFullYear();
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content="/img/tay-bw-1800.jpg" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Inter+Tight:wght@400;500;600;700&family=Instrument+Serif:ital@0;1&family=JetBrains+Mono:wght@400;500&display=swap" rel="stylesheet" />
    <script is:inline>
      try {
        var t = localStorage.getItem("ty-theme");
        if (t) document.documentElement.dataset.theme = t;
        if (sessionStorage.getItem("ty-wipe") && !matchMedia("(prefers-reduced-motion: reduce)").matches) document.documentElement.classList.add("t-in");
        sessionStorage.removeItem("ty-wipe");
      } catch (e) {}
    </script>
  </head>
  <body>
    <div class="wipe" aria-hidden="true"><i></i><i><b><span>Tay Yong</span></b></i></div>
    <div class="grain" aria-hidden="true"></div>
    <div class="progress" aria-hidden="true"></div>
    <div class="cur" aria-hidden="true"></div>
    <div class="toast" role="status" aria-live="polite"></div>

    <header class="top mono">
      <a href="/" class="logo" data-wipe="Index">Tay Yong<sup>©{String(year).slice(2)}</sup></a>
      <nav class="navl" aria-label="Main">
        {links.map((l) => (
          <a href={l.href} class={l.on ? "on" : ""} data-wipe={l.label} data-scramble>{l.label}</a>
        ))}
      </nav>
      <div class="hdr-r">
        <span class="hdr-clock" data-clock>NYC 00:00:00</span>
        <button class="hdr-btn" type="button" data-theme-toggle aria-label="Toggle lights"><span class="lamp"></span><span data-scramble>Lights</span></button>
        <button class="hdr-btn" type="button" data-palette aria-label="Open menu"><span data-scramble>Menu</span><kbd>⌘K</kbd></button>
      </div>
    </header>

    <main><slot /></main>

    <footer class="foot">
      <div class="foot-row mono">
        <span>© {year} Tay Yong</span>
        <a href="mailto:hello@tayyong.com" class="ulink">hello@tayyong.com</a>
        <span data-clock="Local time — NYC ">Local time</span>
        <a href="#top" data-no-wipe onclick="window.scrollTo({ top: 0, behavior: 'smooth' }); return false;" class="ulink" style="justify-self:end">Back to top ↑</a>
      </div>
      <div class="foot-name-box"><div class="foot-name" data-rise data-fit="0.998" aria-hidden="true"><span>Tay</span><span>Yong</span></div></div>
    </footer>

    <div class="pal" role="dialog" aria-modal="true" aria-label="Menu">
      <div class="pal-bg" data-pal-close></div>
      <div class="pal-box">
        <input class="pal-in" type="text" placeholder="Where to? Try “food”, “cv”, “lights”…" aria-label="Search the menu" />
        <ul class="pal-list" role="listbox"></ul>
        <div class="pal-foot mono"><span>↑↓ move</span><span>↵ open</span><span>esc close</span></div>
      </div>
    </div>
  </body>
</html>

<script>
  import "../scripts/motion.js";
</script>
